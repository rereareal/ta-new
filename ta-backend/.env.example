# 复制为 .env 后再启动：cp .env.example .env
# .env 已被 .gitignore 忽略，不要把真实密钥提交到仓库。

DATABASE_URL=sqlite:///./ta.db

# JWT 签名密钥（必填；生产环境请用随机长字符串替换，例如：python -c "import secrets; print(secrets.token_urlsafe(32))"）
SECRET_KEY=dev-only-secret-key-change-me-in-production
ALGORITHM=HS256

# token 有效期（分钟），默认 1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
