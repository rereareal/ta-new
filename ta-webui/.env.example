# Copy this file to .env.local for local development.
# Vite exposes only variables prefixed with VITE_ to the browser.
#
# Development requests go through the Vite /api proxy (see vite.config.ts).
# For a different local API port, set VITE_API_BASE_URL to an absolute URL.
# For production, set it to the browser-reachable API origin, for example:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/api

# 演示模式：开发环境默认开启；设置为 false 时调用真实后端接口。
# VITE_DEMO_MODE=false
